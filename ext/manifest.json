{
  "name": "Bookmarklet Runner",
  "version": "0.1.0",
  "manifest_version": 3,
  "description": "Run bookmarklets from a toolbar button and configurable keyboard shortcuts",
  "homepage_url": "https://github.com/waynesbrain/bm-runner",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options/options.html",
  "action": {
    "default_title": "Run toolbar bookmarklet",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "bookmarks",
    "activeTab",
    "storage",
    "scripting",
    "declarativeNetRequest"
  ],
  "commands": {
    "run-bookmarklet-1": {
      "suggested_key": { "default": "Ctrl+Shift+1" },
      "description": "Run bookmarklet #1"
    },
    "run-bookmarklet-2": {
      "suggested_key": { "default": "Ctrl+Shift+2" },
      "description": "Run bookmarklet #2"
    },
    "run-bookmarklet-3": {
      "suggested_key": { "default": "Ctrl+Shift+3" },
      "description": "Run bookmarklet #3"
    },
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+B" },
      "description": "Run the toolbar bookmarklet"
    }
  }
}
